public class RegresionLinealSimple {
    public static void main(String[] args) {

        double[] x = {23, 26, 30, 34, 43, 48, 52, 57};
        double[] y = {651, 762, 856, 1063, 1190, 1298, 1421, 1440};

        int n = x.length;

        double sumaX = 0;
        double sumaY = 0;
        double sumaXY = 0;
        double sumaX2 = 0;

        for (int i = 0; i < n; i++) {
            sumaX += x[i];
            sumaY += y[i];
            sumaXY += x[i] * y[i];
            sumaX2 += x[i] * x[i];
        }

        double beta1 = (n * sumaXY - sumaX * sumaY)
                / (n * sumaX2 - sumaX * sumaX);

        double beta0 = (sumaX2 * sumaY - sumaX * sumaXY)
                / (n * sumaX2 - sumaX * sumaX);

        System.out.printf(
                "Ecuacion de regresion: y = %.2f + %.2fx\n",
                beta0, beta1
        );

        double xPrediccion = 57.5;
        double yPrediccion = beta0 + beta1 * xPrediccion;

        System.out.printf(
                "\nPara x = %.2f, la prediccion de y es: %.2f\n",
                xPrediccion, yPrediccion
        );
    }
}
